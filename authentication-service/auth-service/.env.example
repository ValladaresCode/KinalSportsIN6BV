# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=KinalSports
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# JWT Settings
JWT_SECRET_KEY=your_secret_key_here_min_256_bits
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService
JWT_EXPIRY_MINUTES=30

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_BASE_URL=https://res.cloudinary.com/your_cloud_name/image/upload/
CLOUDINARY_DEFAULT_AVATAR=your_default_avatar_path
CLOUDINARY_FOLDER=auth_service/profiles

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Kinal Sports

# Application Settings
FRONTEND_URL=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5156;http://localhost:5156

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
